# HakiOS fragment: the Qualcomm SC7280 family (SM7325, QCM6490: "yupik", "kodiak") -- what is true of the SoC, whatever phone it is in.
# The processor has eight cores and the biggest is core 7; the temperature sensors, the chip-identity memory and the PMIC arbiter are
# at the addresses of this family (the kernel's defaults, which a port to another SoC overrides: soc_smem, thermal_tm0/1 ...).
# The sensors are read (CONFIG_THERMAL), and with them the run is handed back to the loader at 105 degrees, the driver's own default
# (the log says "thermal: ... stop at 105 C"); CONFIG_THERMAL_STOP=N in a device's fragment sets another limit, 0 none.
CONFIG_SOC="sc7280"
CONFIG_CPUS=8
CONFIG_BOOTCPU=7
CONFIG_CPUFREQ=y
CONFIG_SOCINFO=y
CONFIG_THERMAL=y
# the drivers of this SoC family: a device with it gets them from here, whatever phone-specific drivers it leaves out
CONFIG_HAKIOS_CPUFREQ=y
CONFIG_HAKIOS_SOCINFO=y
CONFIG_HAKIOS_THERMAL=y
CONFIG_HAKIOS_PMIC=y
